# ==============================================================================
# Enterprise AI Assistant — Production Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env and replace placeholder values with your real secrets.
# NEVER commit .env or real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
PROJECT_NAME="Enterprise AI Assistant"
VERSION=1.0.0
# Set to 'production' for live deployments, or 'development' / 'testing' locally
ENVIRONMENT=production
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
# Use asyncpg scheme for asynchronous SQLAlchemy connection pooling
DATABASE_URL=postgresql+asyncpg://postgres:YourSecureDbPassword@postgres:5432/enterprise_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YourSecureDbPassword
POSTGRES_DB=enterprise_ai

# ------------------------------------------------------------------------------
# 3. REDIS CONFIGURATION (Caching & Distributed Rate Limiting)
# ------------------------------------------------------------------------------
REDIS_URL=redis://:YourSecureRedisPassword@redis:6379/0
REDIS_ENABLED=true

# ------------------------------------------------------------------------------
# 4. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Generate a cryptographically strong secret: openssl rand -hex 32
JWT_SECRET=generate_a_minimum_64_character_random_hex_string_for_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 5. CORS ORIGINS (Explicitly configured; NO wildcard '*' when credentials=true)
# ------------------------------------------------------------------------------
BACKEND_CORS_ORIGINS=["https://app.yourdomain.com", "https://api.yourdomain.com", "http://localhost:3000"]

# ------------------------------------------------------------------------------
# 6. LLM & EMBEDDING PROVIDERS
# ------------------------------------------------------------------------------
# Provider choice: 'gemini', 'openai', or 'ollama'
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
VECTOR_DIMENSION=768

# API Keys (Provide according to selected provider)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 7. DOCUMENT & OBJECT STORAGE
# ------------------------------------------------------------------------------
# 's3' for production S3/MinIO/Cloudflare R2, 'local' for local development
STORAGE_BACKEND=local
STORAGE_PATH=./storage
S3_BUCKET_NAME=enterprise-ai-documents
S3_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com
S3_REGION_NAME=us-east-1
S3_ACCESS_KEY_ID=your_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key

# ------------------------------------------------------------------------------
# 8. RATE LIMITING & RESOURCE LIMITS
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=15
RATE_LIMIT_AI_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_MINUTE=20
RATE_LIMIT_WORKFLOW_PER_MINUTE=20
MAX_REQUEST_BODY_BYTES=10485760
WORKFLOW_MAX_STEPS=50
MAX_UPLOAD_SIZE_MB=50

# ------------------------------------------------------------------------------
# 9. FRONTEND ENVIRONMENT (Used by Next.js client)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
