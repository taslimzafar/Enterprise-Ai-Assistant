# ==============================================================================
# Enterprise AI Assistant — Backend Environment (.env.example)
# ==============================================================================
ENVIRONMENT=production
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_ai

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# Security
JWT_SECRET=replace_with_a_secure_random_key_for_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# LLM Providers
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
VECTOR_DIMENSION=768
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Storage
STORAGE_BACKEND=local
STORAGE_PATH=./storage
S3_BUCKET_NAME=enterprise-ai-documents

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=15
RATE_LIMIT_AI_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_MINUTE=20
RATE_LIMIT_WORKFLOW_PER_MINUTE=20
